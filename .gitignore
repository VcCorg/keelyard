# KEEL Agentic Project - Monorepo Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# The Python build-artifact rules above (lib/, build/, dist/, ...) are unanchored
# and would also swallow real frontend SOURCE dirs. Keep those tracked.
!dashboard/frontend/src/lib/
!dashboard/frontend/src/lib/**

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nyc_output
coverage.xml
*.cover
.hypothesis/

# Environment
.env
.env.local
.env.development
.env.test
.env.production

# Data
*.db
*.sqlite
*.sqlite3

# Dashboard background service pid files (logs covered by *.log)
*.pid
dashboard/.backend.pid
dashboard/.frontend.pid
chroma_db/
data/
logs/
*.log

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# React/Vite
dist/
build/
.eslintcache

# desktop/build/ is electron-builder buildResources (icons, entitlements), NOT a
# Python/Vite build dir — must come after the unanchored build/ rules to win.
# Transient desktop outputs are ignored via desktop/.gitignore instead.
!desktop/build/
!desktop/build/**

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db
*.tmp
*.temp

# Backup files
*.bak
*.bak[0-9]*
*.backup
*.old

# Generated knowledge-graph exports & visualizations (regenerated by the CLI)
knowledge-export/
graphify-out/
*.graph.html
graph*.html
*-graph.html
*-knowledge-graph.html
kg-infrastructure/**/*.html

# --- Company-specific / internal data — MUST NOT be checked in ---
