# Weaviate Configuration
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http

# Vectorizer Configuration
# Options: text2vec-transformers, text2vec-openai, text2vec-cohere, text2vec-huggingface
DEFAULT_VECTORIZER=text2vec-transformers

# Model Configuration (for text2vec-transformers)
TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Query Configuration
QUERY_DEFAULTS_LIMIT=25
QUERY_DEFAULTS_NEAR_VECTOR_DISTANCE=0.2

# Persistence
PERSISTENCE_DATA_PATH=/var/lib/weaviate

# Authentication (set to 'false' for local development)
AUTHENTICATION_ENABLED=false
