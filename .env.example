# Agentic CLI environment configuration
#
# Configure integration tokens ONCE here instead of exporting them into your
# shell every session. Copy this file to one of:
#
#   ~/.dva/.env    (global, machine-wide — loaded from any directory)
#   ./.env         (project-local — overrides the global file)
#
# Precedence (low -> high):  ~/.dva/.env  ->  ./.env  ->  real exported vars
# Real `export`ed shell variables ALWAYS win, so this is safe in CI.
#
# Quick start:
#   dva env init            # scaffold ~/.dva/.env from this template
#   dva env validate        # check required keys resolve
#   dva env path            # show which files are loaded
#
# NOTE: .env is git-ignored. Never commit real tokens.

# --- Jira ---------------------------------------------------------
# Base URL, e.g. https://jira.company.com (required)
JIRA_SERVER_URL=
# Personal access token for Jira (required)
JIRA_PERSONAL_ACCESS_TOKEN=

# --- Confluence ---------------------------------------------------
# Base URL, e.g. https://confluence.company.com (required)
CONFLUENCE_SERVER_URL=
# Personal access token for Confluence (required)
CONFLUENCE_PERSONAL_ACCESS_TOKEN=

# --- Bitbucket ----------------------------------------------------
# Base URL, e.g. https://bitbucket.company.com (required)
BITBUCKET_SERVER_URL=
# Personal access token for Bitbucket (required)
BITBUCKET_PERSONAL_ACCESS_TOKEN=

# --- AI / Google Cloud (Vertex AI) --------------------------------
# GCP project id for Vertex AI
GOOGLE_PROJECT_ID=
# Vertex AI location/region
GOOGLE_LOCATION=us-central1
# Default Vertex AI model id
VERTEX_AI_MODEL=gemini-2.0-flash-001
# Google/Gemini API key (alternative to a Vertex project)
GOOGLE_API_KEY=
# Gemini API key (alias of GOOGLE_API_KEY)
GEMINI_API_KEY=

# --- MCP endpoints ------------------------------------------------
# MCP gateway URL (optional)
MCP_GATEWAY_URL=
# Jira MCP SSE URL
MCP_JIRA_URL=http://localhost:8128/sse
# Confluence MCP SSE URL
MCP_CONFLUENCE_URL=http://localhost:8129/sse
# Bitbucket MCP SSE URL
MCP_BITBUCKET_URL=http://localhost:8126/sse

# --- Glean (enterprise search / context) --------------------------
# Glean instance URL, e.g. https://company-be.glean.com
GLEAN_API_URL=
# How to authenticate to Glean: 'token' or 'sso'
GLEAN_AUTH_MODE=token
# Glean API token (token mode)
GLEAN_API_TOKEN=
# OIDC issuer URL for Glean SSO (sso mode)
GLEAN_OAUTH_ISSUER=
# OAuth client id for Glean SSO (sso mode)
GLEAN_OAUTH_CLIENT_ID=
# OAuth client secret for a Glean service token (sso mode)
GLEAN_OAUTH_CLIENT_SECRET=
# OAuth scope(s) for the Glean service token (sso mode)
GLEAN_OAUTH_SCOPE=
# OAuth token endpoint (else derived via OIDC discovery)
GLEAN_OAUTH_TOKEN_URL=

# --- Optional tooling ---------------------------------------------
# Devin API key for cloud sessions/knowledge
DEVIN_API_KEY=
# Path/URL to the skills registry
DVA_SKILLS_REGISTRY=
