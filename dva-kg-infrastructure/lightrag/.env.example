# LightRAG Configuration
LIGHTRAG_WORKING_DIR=/data/lightrag
LIGHTRAG_LOG_LEVEL=INFO

# LLM Provider Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Alternative: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Alternative: Google Vertex AI
# LLM_PROVIDER=vertex_ai
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GOOGLE_LOCATION=us-central1
# VERTEX_AI_MODEL=gemini-pro

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Configuration
# Options: nano-vectordb (default, lightweight), milvus (production), chromadb
VECTOR_STORE=nano-vectordb

# Graph Store Configuration
# Options: networkx (default, in-memory), neo4j (production)
GRAPH_STORE=networkx

# Neo4j Configuration (if using neo4j graph store)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Performance Settings
MAX_ASYNC_WORKERS=4
MAX_TOKENS=32768
MAX_EMBED_TOKENS=8192

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8001
