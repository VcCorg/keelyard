# MCP Docker Stack Environment Variables
# Copy to .env or pass via: docker compose --env-file .env.mcp -f mcp-docker-compose.yml up -d

# Bitbucket MCP
BITBUCKET_SERVER_URL=https://bitbucket.example.com
BITBUCKET_PERSONAL_ACCESS_TOKEN=your-bitbucket-pat-here

# Glean MCP
GLEAN_API_TOKEN=
GLEAN_DOMAIN=https://example-production-be.glean.com

# Jira MCP
JIRA_SERVER_URL=https://jira.example.com
JIRA_PERSONAL_ACCESS_TOKEN=your-jira-pat-here

# Confluence MCP
CONFLUENCE_SERVER_URL=https://confluence.example.com
CONFLUENCE_PERSONAL_ACCESS_TOKEN=your-confluence-pat-here
CONFLUENCE_DEFAULT_SPACE=

# Memory MCP (neo4j-agent-memory)
NEO4J_URI=bolt://dva-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# KG MCP (Knowledge Graph business context)
KG_LIGHTRAG_URL=http://dva-lightrag:8001
KG_DEFAULT_PROVIDER=lightrag
